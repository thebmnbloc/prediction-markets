# Kalshi API credentials
# Get these from https://kalshi.com/account/api (or demo.kalshi.co for sandbox)
KALSHI_API_KEY_ID=your-kalshi-api-key-uuid
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
KALSHI_ENV=demo  # "demo" or "production"

# Polymarket API credentials
# Derived from your Ethereum/Polygon wallet
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HEX
POLYMARKET_ENV=production  # "staging" or "production"

# Application settings
DATABASE_URL=postgres://quant:quant@localhost:5432/quantdb
LOG_LEVEL=info
DRY_RUN=true  # Set to "false" to enable live trading
